<Project>
  <PropertyGroup>
    <!-- Common build properties -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Enables debugging into NuGet packages by linking back to the original source code on GitHub -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- SourceLink ships built into the .NET SDK (net8+): no Microsoft.SourceLink
         package reference — an explicit one would suppress the built-in
         (SuppressImplicitGitSourceLink) and break Central Package Management
         consumers (inline versions are NU1008 under CPM). -->
    <!-- Includes source from non-tracked files (helpful for debugging modified but uncommitted code) -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Includes symbol packages when packing a NuGet package (snupkg) -->
    <IncludeSymbols>true</IncludeSymbols>
    <!-- Uses the modern symbol package format that's more compatible with NuGet -->
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Analysis settings -->
    <!-- Uses the latest available analysis rules -->
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Enables all code analyzers rather than just the recommended subset -->
    <AnalysisMode>All</AnalysisMode>
    <!-- Activates the built-in .NET code analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Documentation -->
    <!-- Generates XML documentation files for all projects (required for SDK-style API documentation) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- With GenerateDocumentationFile on, the compiler warns (CS1591) for every
         publicly visible type/member without an XML doc comment. Together with
         TreatWarningsAsErrors this makes documentation part of the build:
         public APIs describe their contract. Document private helpers only when
         their behaviour needs explanation; never add filler to satisfy the
         warning. This root copy mirrors standards/Directory.Build.props (the
         seeded default); keep both in step. -->
    <!-- <NoWarn> deliberately does not suppress CS1591: public API docs are required. -->
  </PropertyGroup>
</Project>
