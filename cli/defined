#!/usr/bin/env bash
# cli/defined — installed host launcher for the defined gate (decision #25).
#
# The only public surface: `defined comply` and `defined verify`. `comply` is
# the command to use locally and for agent work (bootstrap + repair + verify);
# `verify` is the read-only check the pipeline runs and nothing else. Reads
# the consumer's committed .defined.json `version` (omitted → current default
# image), picks a container engine (podman preferred), ensures the exact image
# is present, then runs it — mounting the repo read-write for comply,
# read-only for verify. No gate behaviour lives here; everything else is in
# the image.
#
# Needs only git + podman/docker on the host. Install: put this file on PATH
# (normally ~/.local/bin/defined). Source development uses runtime/comply.sh.
# The runtime's .defined.json parser is exercised here end-to-end; the
# producer repo commits its own versionless config (a coverage pin, see the
# repo root .defined.json).

set -euo pipefail

CONFIG_FILE=".defined.json"
IMAGE_REPO="ghcr.io/markstanden/defined"
PROGRAM="$(basename "${BASH_SOURCE[0]}")"

usage() {
    echo "usage: ${PROGRAM} comply | ${PROGRAM} verify" >&2
    return 0
}

die() {
    echo "${PROGRAM}: $*" >&2
    exit 1
}

# Resolve the enclosing git root from the invocation CWD.
repo_root() {
    git -C "${PWD}" rev-parse --show-toplevel 2>/dev/null ||
        die "not inside a git repository"
}

# Read and validate the immutable image pin from .defined.json.
# Prints the image tag to run: a validated immutable pin when the file holds
# one, otherwise the default `latest` tag. A missing file or an omitted
# `version` both mean "current published default image" (release identity
# defaults are obvious; explicit values are overrides). Explicit mutable
# aliases (latest, non-SHA tokens) are rejected so a *written* pin is always
# the exact image local and CI run (release identity, PLAN.md).
read_pin() {
    local root="$1"
    local file="${root}/${CONFIG_FILE}"
    if [[ ! -f "${file}" ]]; then
        echo "latest"
        return 0
    fi
    # Extract the "version" field from the JSON document without jq: target the
    # `"version": "<hex>"` line/segment and strip quotes + surrounding chars.
    local pin
    pin="$(tr -d '[:space:]' <"${file}" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
    if [[ -z "${pin}" ]]; then
        echo "latest"
        return 0
    fi
    if [[ "${pin}" == "latest" ]]; then
        die "${file} must pin an immutable tag, not 'latest' — omit 'version' to use the default"
    fi
    if [[ ! "${pin}" =~ ^[0-9a-f]{7,40}$ ]]; then
        die "${file} has an invalid pin '${pin}' — expected a git SHA"
    fi
    echo "${pin}"
}

# Choose the engine: podman preferred over docker; absent engine fails loudly.
pick_engine() {
    local engine="${DEFINED_ENGINE:-}"
    if [[ -n "${engine}" ]]; then
        command -v "${engine}" >/dev/null 2>&1 ||
            die "engine '${engine}' not found"
        echo "${engine}"
        return 0
    fi
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    elif command -v docker >/dev/null 2>&1; then
        echo "docker"
    else
        die "no container engine found — install podman or docker"
    fi
}

# Ensure the exact image is present; pull on first use, fail offline.
ensure_image() {
    local engine="$1" image="$2"
    if "${engine}" image inspect "${image}" >/dev/null 2>&1; then
        return 0
    fi
    if ! "${engine}" pull "${image}" >/dev/null 2>&1; then
        die "image ${image} unavailable (offline, or pin not yet published?)"
    fi
    return 0
}

main() {
    local verb="${1:-}"
    if [[ "${verb}" == "-h" || "${verb}" == "--help" ]]; then
        usage
        return 0
    fi
    if [[ "${verb}" != "comply" && "${verb}" != "verify" ]]; then
        usage
        return 2
    fi

    local root engine pin image
    root="$(repo_root)" || return 1
    engine="$(pick_engine)" || return 1
    pin="$(read_pin "${root}")" || return 1
    image="${IMAGE_REPO}:${pin}"
    ensure_image "${engine}" "${image}" || return 1

    # Decision #3: project deps restore inside the container onto named
    # volumes keyed by pin + repo, so host↔image ABI mismatches never leak in
    # and a pin change gets a fresh dependency cache.
    local repo_hash mount_arg
    repo_hash="$(printf '%s' "${root}" | sha256sum | cut -c1-12)"
    mount_arg="-v ${root}:/repo"
    if [[ "${verb}" == "verify" ]]; then
        mount_arg="-v ${root}:/repo:ro"
    fi

    # The image runs as non-root (uid 1000): map the invoking host user onto
    # that uid so the mounted repo and the cache volumes stay writable —
    # podman via --userns=keep-id, docker (rootful) via --user.
    local -a user_args
    if [[ "${engine}" == "podman" ]]; then
        user_args=("--userns=keep-id:uid=1000,gid=1000")
    else
        user_args=(--user "$(id -u):$(id -g)")
    fi

    # shellcheck disable=SC2086 # mount_arg is two words by design
    "${engine}" run --rm \
        "${user_args[@]}" \
        ${mount_arg} \
        -v "defined-node-${pin}-${repo_hash}:/repo/node_modules" \
        -v "defined-npm-${repo_hash}:/home/node/.npm" \
        -v "defined-nuget-${repo_hash}:/home/node/.nuget/packages" \
        -e "NUGET_PACKAGES=/home/node/.nuget/packages" \
        --workdir /repo \
        "${image}" "${verb}"
}

main "$@"
