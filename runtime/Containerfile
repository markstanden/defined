# Defined runtime image.
#
# Official node slim base, digest-pinned via tool-versions.env (multi-arch
# manifest list, so arm64 works unmodified). Build context is the repo root so
# the runtime (gate code), the shared lib/ and the standards/ dir can all be
# baked in: the published image is fully self-contained (code + configs +
# standards + tools) for CI consumers who vendor nothing. Locally, comply.sh bind-mounts runtime/, lib/
# and standards/ read-only at /opt/defined/* — shadowing the baked copies — so
# local edits run without a rebuild; only tool pins change this image's local
# tag. Base image pins arrive as build args from comply.sh (which sources
# tool-versions.env) so that file remains the single source of truth.
# Base image pins arrive as build args from comply.sh (which sources
# tool-versions.env) so that file remains the single source of truth. The
# defaults below exist only so a bare `docker build` (or the buildkit linter)
# has a valid base image name — they must mirror tool-versions.env, and the
# node version assertion in the first RUN gates any drift loudly.
ARG NODE_IMAGE_TAG=26.7.0-slim
ARG NODE_IMAGE_DIGEST=sha256:5758d367d7b4f48b73a9bb3530e687e47efb289f3b43f9c0450a25225ae0db5d

FROM docker.io/library/node:${NODE_IMAGE_TAG}@${NODE_IMAGE_DIGEST}

ENV DEBIAN_FRONTEND=noninteractive

COPY runtime/tool-versions.env /usr/local/share/defined/tool-versions.env

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git \
        shellcheck \
        shfmt \
        yamllint \
        curl \
        ca-certificates \
        unzip \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    . /usr/local/share/defined/tool-versions.env; \
    test "$(shellcheck --version | sed -n 's/^version: //p')" = "${SHELLCHECK_VERSION}"; \
    test "$(shfmt --version)" = "${SHFMT_VERSION}"; \
    test "$(yamllint --version | cut -d' ' -f2)" = "${YAMLLINT_VERSION}"; \
    npm install --global "typescript@${TYPESCRIPT_VERSION}"; \
    npm install --global "prettier@${PRETTIER_VERSION}"; \
    tsc --version; \
    test "$(prettier --version)" = "${PRETTIER_VERSION}"; \
    arch="$(uname -m)"; \
    case "${arch}" in \
        x86_64) ARCH="amd64"; ZIZMOR_ARCH="x86_64"; GITLEAKS_ARCH="x64" ;; \
        aarch64) ARCH="arm64"; ZIZMOR_ARCH="aarch64"; GITLEAKS_ARCH="arm64" ;; \
        *) echo "Unsupported arch: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --retry-all-errors "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${ARCH}.tar.gz" | tar -xz -C /usr/local/bin actionlint; \
    actionlint --version >/dev/null; \
    curl -fsSL --retry 3 --retry-all-errors "https://github.com/zizmorcore/zizmor/releases/download/v${ZIZMOR_VERSION}/zizmor-${ZIZMOR_ARCH}-unknown-linux-gnu.tar.gz" | tar -xz -C /usr/local/bin zizmor; \
    zizmor --version >/dev/null; \
    curl -fsSL --retry 3 --retry-all-errors "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" | tar -xz -C /usr/local/bin gitleaks; \
    gitleaks --version >/dev/null; \
    curl -fsSL --retry 3 --retry-all-errors "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${ARCH}.tar.gz" | tar -xz -C /usr/local/bin tofu; \
    tofu --version >/dev/null; \
    curl -fsSL --retry 3 --retry-all-errors "https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}/tflint_linux_${ARCH}.zip" -o /tmp/tflint.zip; \
    unzip -o /tmp/tflint.zip -d /usr/local/bin; \
    rm /tmp/tflint.zip; \
    test "$(tflint --version | sed -n 's/^TFLint version //p')" = "${TFLINT_VERSION}"; \
    test "$(node --version)" = "v${NODE_IMAGE_TAG%-slim}"

# The gate mounts the consumer repo at /repo; in CI that checkout is owned by
# the runner uid, not the container root, so git's dubious-ownership guard
# (CVE-2022-24765) would refuse it. Whitelist the gate's own mount point in
# the system config (protected scope) — the only path git ever touches here.
RUN git config --system --add safe.directory /repo

# Dotnet SDK: Debian main does not ship dotnet, so add Microsoft's Debian-13
# apt feed (x64 + arm64) and install the SDK via apt. The pinned version is
# asserted at build time like the other tools, so feed drift fails the build.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        wget \
        gpg \
    ; \
    wget -qO /tmp/packages-microsoft-prod.deb \
        "https://packages.microsoft.com/config/debian/13/packages-microsoft-prod.deb"; \
    dpkg -i /tmp/packages-microsoft-prod.deb; \
    rm /tmp/packages-microsoft-prod.deb; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        dotnet-sdk-10.0 \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    . /usr/local/share/defined/tool-versions.env; \
    test "$(dotnet --version)" = "${DOTNET_SDK_VERSION}"; \
    dotnet --info >/dev/null

# Suppress the .NET first-run experience (welcome banner, ASP.NET dev-cert
# install) and telemetry: a fresh container would otherwise print the banner to
# stderr on the first triggering dotnet call, polluting step failure output.
ENV DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1

# Bake the runtime, shared lib and standards in so the published image is
# self-contained. Local runs still bind-mount runtime/ + lib/ ro over these
# paths (live edits, no rebuild); CI consumers use the baked copies and vendor
# nothing.
COPY runtime /opt/defined/runtime
COPY lib /opt/defined/lib
COPY standards /opt/defined/standards

WORKDIR /repo
ENTRYPOINT ["node", "/opt/defined/runtime/comply.mts"]
