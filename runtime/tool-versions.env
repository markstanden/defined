#!/usr/bin/env bash
# Pinned tool versions for the quality gate image.
#
# Single source of truth: sourced by the Containerfile at build time; the
# shim (comply.sh) derives the image tag from this file's content hash, so
# any pin change forces an image rebuild. Tools land here together with the
# step that needs them — nothing speculative.
#
# Base image: official node slim, digest-pinned (multi-arch manifest list)
# so rebuilds are reproducible and arm64 hosts work unmodified.

NODE_IMAGE_TAG="26.13.1-slim"
NODE_IMAGE_DIGEST="sha256:a5a5adfee3013de54504e0e6aff49993acf7daed072e86be75b8818c0f6ac258"

# Global typescript inside the image: used to typecheck the gate's own code
# (`tsc --noEmit`). The gate still *runs* on node strip-types with no build.
TYPESCRIPT_VERSION="7.0.2"

# Shell step tools. Installed from upstream release assets, not the base
# image's apt feed: trixie carries shellcheck 0.10.0 and shfmt 3.8.0, so the
# feed capped both pins (a higher pin failed the build at the assert). The
# build still asserts the installed versions, which is what catches an upstream
# asset-naming change.
#
# Neither project publishes a checksum asset, so the sha256 below is a hand
# pin, derived from the release asset on 2026-11-15 and verified by the build
# before anything is unpacked into PATH. It is the only record of the bytes we
# trust: a bump means deliberately re-deriving it from the new asset, never
# copying a hash from a third party.
SHELLCHECK_VERSION="0.11.0"
SHELLCHECK_SHA256_AMD64="b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6"
SHELLCHECK_SHA256_ARM64="68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc"
SHFMT_VERSION="3.14.1"
SHFMT_SHA256_AMD64="76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf"
SHFMT_SHA256_ARM64="5f2db09dae91fca848f7adbdd014632e921a383863a2ad7e0450ad3aba0c6489"

# YAML step tool, installed via apt and asserted at build time like above.
# CEILING: the feed carries 1.37.1, so this pin cannot move without changing the
# install path — and yamllint is a Python tool while the base image ships no
# python3, so pip would add python3 + pip (~100 MB) for a point release. Stay on
# the feed until a larger reason appears. Do not "fix" this by unpinning: the
# assert is what fails loudly when the feed drops the version.
YAMLLINT_VERSION="1.37.1"

# Node step: prettier (global npm install, asserted at build time).
PRETTIER_VERSION="3.10.1"

# ESLint step: lint engine + house rule plugins. `eslint` is installed globally
# (the binary the house-config pass calls, asserted at build time); the whole
# stack is installed a second time under /opt/defined so the baked config's ESM
# imports resolve (see the Containerfile). eslint-plugin-regexp supplies the
# super-linear-regex floor that motivated the step.
ESLINT_VERSION="10.15.0"
TYPESCRIPT_ESLINT_VERSION="8.72.2"
ESLINT_PLUGIN_REGEXP_VERSION="3.3.3"
ESLINT_CONFIG_PRETTIER_VERSION="10.1.8"
# Core recommended rules (@eslint/js) and the Node globals map the house config
# declares so the core no-undef rule does not flag process/console/module in
# .js/.mjs/.cjs (2026-10-12). ESLint 10 no longer bundles @eslint/js.
ESLINT_JS_VERSION="10.0.1"
GLOBALS_VERSION="17.14.0"
# JSDoc plugin for the house config's public-API documentation floor (2026-10-03).
# Peer range covers the pinned ESLint 10; its own deps (comment-parser etc.)
# install automatically.
ESLINT_PLUGIN_JSDOC_VERSION="65.4.7"

# TypeScript the lint stack's parser runs on. typescript-eslint 8.x peers
# `typescript >=4.8.4 <6.1.0`, so it cannot use the image's global TypeScript 7
# (pinned above for `tsc --noEmit`). Installed into the same /opt/defined prefix
# as the ESLint plugins, so the parser resolves a supported compiler while a
# repo's own typecheck still uses the global 7. Typed rules remain unadopted
# (they need a tsconfig the baked config does not have); the syntax-only
# recommended set is on since 2026-10-12.
ESLINT_TYPESCRIPT_VERSION="6.0.3"

# Workflow step tools (Go binaries, downloaded as release tarballs).
# actionlint is the maintained fork (kjanat/actionlint): upstream
# rhysd/actionlint is dormant (last release 2026-03-30, maintainer silent since
# ~April) and cannot parse the July-2026 `$/` self-repository syntax, parallel
# steps, or current runner labels/permission scopes. The fork is a drop-in CLI
# replacement (same flags, output, config and file formats), so the Containerfile
# download and the `actionlint --version` assertion are unchanged. The version
# below is the fork's line, not upstream's.
#
# Every download in the image is verified against its pinned sha256 before it is
# unpacked into PATH, and a mismatch fails the build. Where the project publishes
# a checksum asset for the release, the hash below is copied from it
# (actionlint_<v>_checksums.txt, gitleaks_<v>_checksums.txt,
# tofu_<v>_SHA256SUMS, checksums.txt for tflint). zizmor publishes none, so its
# hashes — like shellcheck's and shfmt's above — are hand pins derived from the
# 2026-11-15 assets.
ACTIONLINT_VERSION="1.17.1"
ACTIONLINT_SHA256_AMD64="6bfe0f49f0e108b9b23732baf7de63bfa4d89174fa40f9cb98feb9676df3318f"
ACTIONLINT_SHA256_ARM64="81fa498f30f5dfadcc87fff0ff073281703fc56e9b50bc523b415c69aef0cccc"
ZIZMOR_VERSION="1.32.0"
ZIZMOR_SHA256_AMD64="bb110cc765eca9cd7efb2e284a956be5974c60027b0970f16397d86208a9957b"
ZIZMOR_SHA256_ARM64="cb152b207f815116d7fa1c1ee4614f61578803351395052908095e79adfd9fd0"
GITLEAKS_VERSION="8.30.1"
GITLEAKS_SHA256_AMD64="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
GITLEAKS_SHA256_ARM64="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"

# Tofu step: OpenTofu (downloaded as release tarball).
OPENTOFU_VERSION="1.13.9"
OPENTOFU_SHA256_AMD64="b34b327cc1ef07178207b6f2cd1f5276537d3e5b7be316500f6dac50d4c0a857"
OPENTOFU_SHA256_ARM64="5dc196dde75b667e4806d358310ec96742774cd0993c54c1237efee5644b69b8"

# Tofu step: tflint (downloaded as release zip, like the workflow Go tools).
# SonarQube-compatible HCL lint; runs alongside tofu fmt/init/validate.
TFLINT_VERSION="0.66.0"
TFLINT_SHA256_AMD64="22be11cadc25cd02401e94c0ccc91aa63467debb8485c2a755d98f4c0a9d1e2e"
TFLINT_SHA256_ARM64="1105a0a5ddee7cdac7957a3475571a946b839192ea1bc0c722c6c4686001067e"

# Dotnet step: .NET SDK 10 from Microsoft's Debian-13 apt feed
# (packages.microsoft.com/debian/13/prod; x64 + arm64). Debian main does not
# ship dotnet, so the feed is added in the Containerfile. Unlike the Debian
# main tools above, `dotnet-sdk-10.0` is a *rolling* package: an unpinned
# install silently takes the newest patch, so the build installs the exact
# `${DOTNET_SDK_VERSION}-${DOTNET_SDK_DEB_REVISION}` and asserts the result —
# a feed that no longer carries that build fails loudly instead of drifting.
# The SDK is backwards compatible with net8/net6 targets; a pin change forces
# an image rebuild.
DOTNET_SDK_VERSION="10.0.404"
DOTNET_SDK_DEB_REVISION="1"
