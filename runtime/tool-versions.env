#!/usr/bin/env bash
# Pinned tool versions for the quality gate image.
#
# Single source of truth: sourced by the Containerfile at build time; the
# shim (comply.sh) derives the image tag from this file's content hash, so
# any pin change forces an image rebuild. Tools land here together with the
# step that needs them — nothing speculative.
#
# Base image: official node slim, digest-pinned (multi-arch manifest list)
# so rebuilds are reproducible and arm64 hosts work unmodified.

NODE_IMAGE_TAG="26.10.0-slim"
NODE_IMAGE_DIGEST="sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1"

# Global typescript inside the image: used to typecheck the gate's own code
# (`tsc --noEmit`). The gate still *runs* on node strip-types with no build.
TYPESCRIPT_VERSION="7.0.2"

# Shell step tools. Installed via apt; the build asserts these exact
# versions so base-image drift fails the build instead of silently
# changing gate behaviour.
SHELLCHECK_VERSION="0.10.0"
SHFMT_VERSION="3.8.0"

# YAML step tool, installed via apt and asserted at build time like above.
YAMLLINT_VERSION="1.37.1"

# Node step: prettier (global npm install, asserted at build time).
PRETTIER_VERSION="3.9.9"

# ESLint step: lint engine + house rule plugins. `eslint` is installed globally
# (the binary the house-config pass calls, asserted at build time); the whole
# stack is installed a second time under /opt/defined so the baked config's ESM
# imports resolve (see the Containerfile). eslint-plugin-regexp supplies the
# super-linear-regex floor that motivated the step.
ESLINT_VERSION="10.11.0"
TYPESCRIPT_ESLINT_VERSION="8.70.1"
ESLINT_PLUGIN_REGEXP_VERSION="3.3.1"
ESLINT_CONFIG_PRETTIER_VERSION="10.1.8"

# TypeScript the lint stack's parser runs on. typescript-eslint 8.x peers
# `typescript >=4.8.4 <6.1.0`, so it cannot use the image's global TypeScript 7
# (pinned above for `tsc --noEmit`). Installed into the same /opt/defined prefix
# as the ESLint plugins, so the parser resolves a supported compiler while a
# repo's own typecheck still uses the global 7. Typed rules are deferred to
# config v2.
ESLINT_TYPESCRIPT_VERSION="6.0.3"

# Workflow step tools (Go binaries, downloaded as release tarballs).
ACTIONLINT_VERSION="1.7.12"
ZIZMOR_VERSION="1.30.1"
GITLEAKS_VERSION="8.30.1"

# Tofu step: OpenTofu (downloaded as release tarball).
OPENTOFU_VERSION="1.12.6"

# Tofu step: tflint (downloaded as release zip, like the workflow Go tools).
# SonarQube-compatible HCL lint; runs alongside tofu fmt/init/validate.
TFLINT_VERSION="0.64.0"

# Dotnet step: .NET SDK 10 from Microsoft's Debian-13 apt feed
# (packages.microsoft.com/debian/13/prod; x64 + arm64). Debian main does not
# ship dotnet, so the feed is added in the Containerfile. Unlike the Debian
# main tools above, `dotnet-sdk-10.0` is a *rolling* package: an unpinned
# install silently takes the newest patch, so the build installs the exact
# `${DOTNET_SDK_VERSION}-${DOTNET_SDK_DEB_REVISION}` and asserts the result —
# a feed that no longer carries that build fails loudly instead of drifting.
# The SDK is backwards compatible with net8/net6 targets; a pin change forces
# an image rebuild.
DOTNET_SDK_VERSION="10.0.401"
DOTNET_SDK_DEB_REVISION="1"
